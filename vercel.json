{
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/client",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/**",
      "excludeFiles": "node_modules/.pnpm/{@mui+*,@sendbird+*,recharts@*,typescript@*,postcss@*,lightningcss@*,rolldown@*,sass@*,prettier@*}/**"
    }
  }
}
